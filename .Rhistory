# 7. VARIABLES AMBIENTALES
# ==============================================
fit <- envfit(
mod,
env[, c("dap", "height")],
permutations = 999
)
# Direcciones de las flechas
ar <- fit$vectors$arrows
# Fuerza de correlación
r <- sqrt(fit$vectors$r)
# Flechas escaladas según la correlación
ar_df <- data.frame(
var  = rownames(ar),
xend = ar[,1] * r * 3,
yend = ar[,2] * r * 3
)
# Cambiar nombres
ar_df <- ar_df %>%
mutate(
var = dplyr::recode(
var,
dap = "DBH",
height = "Height"
)
)
# =====================================================
# 8. RENOMBRAR LOCALIDADES
# =====================================================
plot_names <- c(
"TRU-02" = "FORST-3200",
"TRU-01" = "TLINE-3400",
"ACJ-01" = "TLINE-3500",
"APK-01" = "TLINE-3600"
)
coords$plot_new <- plot_names[coords$plot]
centroides$plot_new <- plot_names[centroides$plot]
# =====================================================
# 9. COLORES
# =====================================================
colores_localidad <- c(
"FORST-3200" = "#006400",
"TLINE-3400" = "#A2CD5A",
"TLINE-3500" = "#DAA520",
"TLINE-3600" = "#8B4513"
)
# ==============================================
# 10. FIGURA FINAL
# ==============================================
library(ggrepel)
dbRDA_plot <- ggplot() +
geom_point(
data = coords,
aes(CAP1, CAP2, fill = plot_new),
shape = 21,
color = "black",
size = 3
) +
geom_text_repel(
data = centroides,
aes(CAP1, CAP2, label = plot_new),
fontface = "bold",
size = 5,
segment.color = NA,
box.padding = 0.4,
point.padding = 0.3,
max.overlaps = Inf
) +
geom_segment(
data = ar_df,
aes(
x = 0,
y = 0,
xend = xend,
yend = yend
),
arrow = arrow(length = unit(0.3, "cm")),
linewidth = 1.2,
color = "red"
) +
geom_text(
data = ar_df,
aes(
x = xend * 1.10,
y = yend * 1.10,
label = var
),
color = "red",
fontface = "bold",
size = 5
) +
geom_hline(
yintercept = 0,
linetype = "dotted",
color = "grey50"
) +
geom_vline(
xintercept = 0,
linetype = "dotted",
color = "grey50"
) +
scale_fill_manual(
values = colores_localidad
) +
labs(
x = "CAP1",
y = "CAP2",
fill = "Locality"
) +
coord_equal() +
theme_minimal(base_size = 14) +
theme(
panel.border = element_rect(
colour = "black",
fill = NA,
linewidth = 1
),
legend.position = "right",
panel.grid.minor = element_line(
colour = "grey85",
linewidth = 0.3
)
)
dbRDA_plot
dbRDA_plot2 <- dbRDA_plot +##PARA hacerlo cuadrado
scale_x_continuous(
limits = c(-4.5, 4.5)
) +
scale_y_continuous(
limits = c(-4.5, 4.5)
)
dbRDA_plot2
